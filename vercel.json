{
  "version": 2,
  "git": {
    "deploymentEnabled": {
      "feedback": false
    }
  },
  "routes": [
    {
      "src": "/api/save",
      "dest": "/api/save.js"
    },
    {
      "src": "/api/review",
      "dest": "/api/review.js"
    },
    {
      "src": "/api/posts",
      "dest": "/api/posts.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/formats/?",
      "dest": "/formats/index.html"
    },
    {
      "src": "/fotoselectie/?",
      "dest": "/fotoselectie/index.html"
    },
    {
      "src": "/brandbook/?",
      "dest": "/brandbook/index.html"
    },
    {
      "src": "/posts/?",
      "dest": "/posts/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}